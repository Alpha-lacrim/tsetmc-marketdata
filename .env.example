# Reference only. Export environment variables in your shell; no .env autoload.
TSETMC_BASE_URL=https://cdn.tsetmc.com/api/
TSETMC_CONNECT_TIMEOUT=5
TSETMC_READ_TIMEOUT=15
TSETMC_WRITE_TIMEOUT=5
TSETMC_POOL_TIMEOUT=5
TSETMC_TOTAL_TIMEOUT=90
TSETMC_MAX_RETRIES=2
TSETMC_MAX_CONNECTIONS=4
TSETMC_PACING_SECONDS=1
TSETMC_BACKOFF_SECONDS=0.5
TSETMC_MAX_BACKOFF_SECONDS=10

# Use independent, locally generated secrets. Do not commit real credentials.
TSETMC_PG_PORT=5542
TSETMC_PG_PASSWORD=REPLACE_WITH_LOCAL_OWNER_SECRET
TSETMC_COLLECTOR_PASSWORD=REPLACE_WITH_LOCAL_COLLECTOR_SECRET
TSETMC_DATABASE_URL=postgresql+asyncpg://tsetmc_collector:REPLACE_WITH_LOCAL_COLLECTOR_SECRET@127.0.0.1:5542/tsetmc_marketdata
TSETMC_MIGRATION_URL=postgresql+asyncpg://tsetmc_owner:REPLACE_WITH_LOCAL_OWNER_SECRET@127.0.0.1:5542/tsetmc_marketdata
